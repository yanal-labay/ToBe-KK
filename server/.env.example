# Template for server/.env — copy this file to `.env` and fill in the blanks.
#
#   cp .env.example .env
#
# The real .env is gitignored and must never be committed. This template is
# the only env file that should ever reach the repo, so keep it free of real
# values: fill in placeholders, not working credentials.

# MongoDB connection string (Atlas cluster or a local mongod).
# The server logs "CRITICAL: MONGO_URI is missing from .env!" and runs
# without a database if this is unset.
MONGO_URI=

# Port the API listens on. Falls back to 5000 when unset.
PORT=5000

# Origin the browser loads the client from, used for the CORS allowlist.
# Must match exactly: the session cookie is SameSite=Lax and CORS runs with
# credentials, so http://localhost:5173 and http://127.0.0.1:5173 are NOT
# interchangeable — mixing them silently breaks login.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign and verify session JWTs. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# There is deliberately no fallback in code, so a missing value doesn't
# quietly downgrade to a guessable default — login just fails instead.
JWT_SECRET=

# Read only by `npm run seed:admin`, which creates or updates ONE admin
# account — the one named here. A different email creates an additional admin
# rather than renaming the existing one. Choose a strong password:
# /admin/login is publicly reachable, and the rate limiter (10 attempts /
# 15 min) slows guessing but doesn't stop it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary, which stores uploaded photos. Required in production: Render's
# filesystem is wiped on every deploy and restart, so images written to
# server/uploads/ would disappear.
#
# These are SERVER-ONLY. The API secret grants full control of the media
# library — never expose it to the client (no VITE_ prefixed copy), since
# anything the browser receives is public.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
